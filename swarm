#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  echo "Usage: swarm [PROJECT_ROOT]"
  echo "       swarm --help"
  echo
  echo "Launch SwarmForge for PROJECT_ROOT (the current directory by default)."
  exit 0
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
launcher="$script_dir/swarmforge/scripts/swarmforge.sh"
shared_articles="$script_dir/swarmforge/scripts/shared-articles"
toolchain_checker="$script_dir/scripts/check-swarmforge-toolchain.mjs"

if [[ ! -x "$launcher" || ! -d "$shared_articles" || ! -f "$toolchain_checker" ]]; then
  echo "SwarmForge's pinned project scripts are incomplete." >&2
  echo "Restore the repository's tracked swarmforge/ directory before launching; automatic network bootstrap is disabled." >&2
  exit 78
fi

if ! command -v node >/dev/null 2>&1; then
  echo "SwarmForge requires the locked Node runtime, but node is not available on PATH." >&2
  echo "Install the version recorded in $script_dir/swarmforge/toolchain.lock.json, then rerun ./swarm." >&2
  exit 78
fi

project_bb_root="$script_dir/tmp/toolchain/babashka"
project_bb="$script_dir/tmp/toolchain/babashka/bin/bb"
if [[ -e "$project_bb_root" || -L "$project_bb_root" ]]; then
  if ! babashka_validation="$(node "$toolchain_checker" --validate-local-babashka 2>&1)"; then
    echo "$babashka_validation" >&2
    echo "SwarmForge refused the unverified project-local Babashka runtime." >&2
    exit 78
  fi
  export PATH="$(dirname "$project_bb"):$PATH"
elif ! command -v bb >/dev/null 2>&1; then
  echo "SwarmForge requires the locked Babashka runtime, but bb is not available on PATH." >&2
  if babashka_guidance="$(node "$toolchain_checker" --print-babashka-guidance 2>&1)"; then
    echo "$babashka_guidance" >&2
  else
    echo "Inspect $script_dir/swarmforge/toolchain.lock.json and install its locked Babashka version on PATH." >&2
  fi
  exit 78
fi

exec "$launcher" "$@"
